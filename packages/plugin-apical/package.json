{
  "name": "@hexkit/plugin-apical",
  "version": "0.0.0",
  "private": false,
  "description": "Apical integration for Hexkit.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "import": "./dist/testing.mjs",
        "default": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "generate:petstore": "craft generate --server --routes -i ../../apps/petstore-sample/openapi.yaml -o ./generated/petstore",
    "test": "vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@apical-ts/craft": "catalog:",
    "@babel/parser": "catalog:",
    "@hexkit/plugin-api": "workspace:*",
    "@readme/openapi-parser": "catalog:",
    "pure-rand": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
