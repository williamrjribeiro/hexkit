{
  "name": "@hexkit/plugin-apical",
  "version": "0.0.0",
  "private": false,
  "description": "Apical integration for Hexkit.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "generate:petstore": "craft generate --server --routes -i ../../apps/petstore-sample/openapi.yaml -o ./generated/petstore",
    "test": "vp test run",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@apical-ts/craft": "catalog:",
    "@hexkit/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
