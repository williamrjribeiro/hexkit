{
  "name": "@hexkit/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line interface for Hexkit.",
  "bin": {
    "cli": "./dist/index.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run --passWithNoTests",
    "check": "vp check"
  },
  "dependencies": {
    "@hexkit/core": "workspace:*",
    "@hexkit/plugin-api": "workspace:*",
    "@hexkit/plugin-apical": "workspace:*",
    "@hexkit/plugin-architecture-hexagonal": "workspace:*",
    "@hexkit/plugin-drizzle": "workspace:*",
    "@hexkit/plugin-hono": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
